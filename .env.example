# =============================================================================
# Fathom Layer — variáveis de ambiente
#
# Copie para .env.local no desenvolvimento. Na Vercel, cadastre cada uma em
# Project Settings -> Environment Variables (Production e Preview).
#
# As NEXT_PUBLIC_* vão para o bundle do navegador e são visíveis a qualquer
# visitante. Nunca coloque segredo com esse prefixo.
# =============================================================================

# --- Supabase: obrigatórias, o site não sobe sem elas ------------------------

# Project Settings -> API. Vai para o cliente; é pública por design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role (sb_secret_...). SÓ no servidor: grava cliques em /out,
# alimenta o /admin e é a única chave que pode chamar consume_rate_limit.
# Sem ela: /admin mostra aviso de configuração, /out redireciona sem
# registrar o clique, e o rate limit do chat não roda.
SUPABASE_SECRET_KEY=

# --- Autenticação do admin --------------------------------------------------

# E-mail do único usuário admin no Supabase Auth. requireAdmin() compara
# contra este valor; sem ele, nenhuma sessão passa pelo /admin.
ADMIN_EMAIL=

# --- IA: necessária para o consultor e para os agentes ----------------------

# Sem saldo nesta conta, /api/chat responde erro e os agentes não executam.
ANTHROPIC_API_KEY=

# --- Site ------------------------------------------------------------------

# URL canônica. Usada pelo MCP server para montar os links do catálogo.
# Em produção: https://fathomlayer.com
NEXT_PUBLIC_SITE_URL=https://fathomlayer.com

# Token do meta de verificação do Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Segredo do webhook POST /api/revalidate. Gere um valor aleatório longo —
# quem tiver este token consegue forçar revalidação de qualquer rota.
REVALIDATION_TOKEN=
